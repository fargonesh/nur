# Copy to .env for local overrides. All optional — same-origin defaults work
# when the server hosts UI+git on one port (e.g. https://nix.fargone.sh).
# Canonical origin for flake refs + display (default: request host).
SITE_ORIGIN=https://nix.fargone.sh
# Port for `node web/server.js` (vite dev proxies /api + /git here).
PORT=3001
# Bare repos dir (default: ./repos next to the project root).
REPOS_DIR=./repos
# Allow anonymous `git push` over HTTP (demo/LAN). Front with auth proxy publicly.
GIT_ALLOW_ANON_PUSH=1
# Frontend build-time overrides (Vite). Prod on one origin needs neither:
# VITE_SITE_ORIGIN=https://nix.fargone.sh
# VITE_GIT_URL=https://nix.fargone.sh/git
