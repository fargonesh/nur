# Copy to .env for local overrides. All optional — same-origin defaults work
# when the server hosts UI+git on one port (e.g. https://nix.fargone.sh).
# Canonical origin for flake refs + display (default: request host).
SITE_ORIGIN=https://nix.fargone.sh
# Port for `node web/server.js` (vite dev proxies /api + /git here).
PORT=3001
# Bare repos dir (default: ./repos next to the project root).
REPOS_DIR=./repos
# JSON storage for SSH keys.
DATA_DIR=./data
# OAuth public client registered at https://fargone.sh
OAUTH_ORIGIN=https://fargone.sh
OAUTH_CLIENT_ID=fg_xxx
# Server-only. Never prefix this with VITE_ or expose it to the browser.
OAUTH_CLIENT_SECRET=
VITE_OAUTH_ORIGIN=https://fargone.sh
VITE_OAUTH_CLIENT_ID=fg_xxx
# Register this exact URI with the OAuth client (no hash or query string).
# Production: https://your-domain.example/
# Local Vite: http://localhost:5173/
# Local Node server: http://localhost:3001/
# Frontend build-time overrides (Vite). Prod on one origin needs neither:
# VITE_SITE_ORIGIN=https://nix.fargone.sh
# VITE_GIT_URL=https://nix.fargone.sh/git
